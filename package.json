{
  "name": "backend-foundation",
  "version": "1.0.0",
  "description": "Modular Monolith backend foundation (Express + TypeScript + Prisma + PostgreSQL)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "worker:dev": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "lint:ci": "eslint \"src/**/*.ts\" --max-warnings=0",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "jest --testPathPattern=\\.e2e\\.spec\\.ts$",
    "test:mutation": "stryker run",
    "test:contract": "jest --config jest.contract.config.ts",
    "perf:login": "k6 run performance-tests/login-load.js",
    "perf:event-crud": "k6 run performance-tests/event-crud-load.js",
    "perf:product-crud": "k6 run performance-tests/product-crud-load.js",
    "perf:user-crud": "k6 run performance-tests/user-crud-load.js",
    "perf:upload": "k6 run performance-tests/upload-load.js",
    "perf:export": "k6 run performance-tests/export-queue-load.js",
    "perf:benchmark": "k6 run performance-tests/benchmark.js",
    "perf:stress": "k6 run performance-tests/stress-test.js",
    "perf:spike": "k6 run performance-tests/spike-test.js",
    "perf:soak": "k6 run performance-tests/soak-test.js",
    "prepare": "husky",
    "audit:check": "node scripts/check-npm-audit.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.637.0",
    "@bull-board/api": "^8.4.0",
    "@bull-board/express": "^8.4.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.54.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.56.0",
    "@opentelemetry/resources": "^1.29.0",
    "@opentelemetry/sdk-node": "^0.56.0",
    "@prisma/instrumentation": "^5.18.0",
    "bullmq-otel": "1.3.1",
    "pdfkit": "^0.19.1",
    "@opentelemetry/semantic-conventions": "1.30.0",
    "@prisma/client": "^5.18.0",
    "@sentry/node": "^8.30.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.13.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "envalid": "^8.0.0",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-basic-auth": "^1.2.1",
    "express-rate-limit": "^7.4.0",
    "google-auth-library": "^9.14.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "node-cron": "^4.6.0",
    "otplib": "^12.0.1",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.3.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/pdfkit": "^0.17.6",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@pact-foundation/pact": "^17.0.1",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.10",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "espree": "^9.6.1",
    "husky": "^9.1.4",
    "jest": "^29.7.0",
    "jest-mock-extended": "^3.0.7",
    "lint-staged": "^15.2.7",
    "pino-pretty": "^11.2.2",
    "prettier": "^3.3.3",
    "prisma": "^5.18.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "overrides": {
    "tar": "^7.5.22",
    "uuid": "^11.1.1",
    "qs": "^6.15.2",
    "fast-uri": "^3.1.6"
  }
}
