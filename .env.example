# Server
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/database_name"

# Dipakai KHUSUS oleh docker-compose.prod.yml untuk substitusi variabel
# (${DB_USER}, dst) — bukan dibaca langsung oleh aplikasi (aplikasi
# hanya baca DATABASE_URL di atas).
DB_USER=app_user
DB_PASSWORD="ganti-dengan-password-kuat-untuk-production"
DB_NAME=app_db

# Security
BCRYPT_SALT_ROUNDS=10
JWT_SECRET="ganti-dengan-string-acak-panjang-dan-rahasia"
# Minimal 32 karakter & bukan nilai umum (mis. "secret") — WAJIB di
# production (env.ts akan menolak start kalau tidak terpenuhi).
# Generate: openssl rand -base64 48
JWT_EXPIRES_IN=1d

# Phase 12 — key AES-256-GCM untuk EncryptionService (column encryption,
# mis. MFA secret). HARUS base64 yang mendekode jadi TEPAT 32 byte.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=""
# Diisi HANYA selama masa transisi rotasi ENCRYPTION_KEY (lihat komentar
# lengkap di env.ts) — kosongkan lagi setelah rotasi selesai.
ENCRYPTION_KEY_PREVIOUS=""

# AWS S3 (Upload Storage)
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID="ganti-dengan-access-key-IAM-anda"
AWS_SECRET_ACCESS_KEY="ganti-dengan-secret-key-IAM-anda"
AWS_S3_BUCKET_NAME="nama-bucket-upload-anda"

# Security — daftar origin frontend yang diizinkan mengakses API ini,
# dipisah koma, TANPA trailing slash. Jangan pernah pakai "*" di production.
CORS_ALLOWED_ORIGINS="http://localhost:5173,https://app.example.com"

# Observability — KEDUANYA OPSIONAL, aplikasi tetap jalan normal kalau kosong.
SENTRY_DSN=""

# Phase 13 — distributed tracing (opsional, default mati). Lihat
# docs/observability-guide.md sebelum mengaktifkan bersamaan dengan
# SENTRY_DSN di atas (potensi overlap instrumentasi).
OTEL_ENABLED=false
OTEL_SERVICE_NAME=backend-foundation
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# Opsional — verifikasi webhook Alertmanager (lihat monitoring/alertmanager/alertmanager.yml)
ALERTMANAGER_WEBHOOK_SECRET=""
LOG_LEVEL="info"

# OAuth — OPSIONAL per provider. Kosongkan provider yang tidak dipakai;
# endpoint-nya akan menolak dengan pesan jelas, bukan membuat startup gagal.
GOOGLE_CLIENT_ID=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Redis — OPSIONAL untuk aplikasi (kosongkan untuk jalan tanpa cache).
REDIS_URL="redis://localhost:6379"
# Phase 14 — lihat docs/scalability-guide.md. Kosongkan semuanya untuk
# perilaku identik dengan sebelum Phase 14.
REDIS_CLUSTER_NODES=""
DATABASE_REPLICA_URL=""
DATABASE_CONNECTION_LIMIT=0
DATABASE_POOL_TIMEOUT_SECONDS=0
EMAIL_QUEUE_CONCURRENCY=5
NOTIFICATION_QUEUE_CONCURRENCY=5
EMAIL_QUEUE_RATE_LIMIT_MAX=100
EMAIL_QUEUE_RATE_LIMIT_DURATION_MS=60000

# Phase 15 (Enterprise Integration) — semua opsional, default "log"
# (tidak benar-benar memanggil vendor apa pun). Lihat
# docs/integrations-guide.md.
EMAIL_PROVIDER=log
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

PUSH_PROVIDER=log
FCM_SERVER_KEY=""

SEARCH_PROVIDER=postgres
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY=""

PAYMENT_PROVIDER=log
STRIPE_SECRET_KEY=""

OBJECT_STORAGE_PROVIDER=s3
LOCAL_STORAGE_DIR="./uploads-local"
# Dipakai KHUSUS oleh docker-compose.prod.yml (bukan dibaca aplikasi
# langsung) untuk mengamankan Redis di lingkungan production.
REDIS_PASSWORD="ganti-dengan-password-kuat-untuk-production"

# Monitoring (docker-compose.monitoring.yml) — OPSIONAL, keduanya
# punya default "admin"/"admin" kalau kosong. WAJIB diganti sebelum
# stack monitoring diekspos di luar localhost.
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="ganti-dengan-password-kuat-untuk-production"
